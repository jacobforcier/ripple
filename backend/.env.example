# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and the SERVICE ROLE key (Settings → API in the Supabase dashboard).
# The service-role key bypasses RLS — keep it server-side only, never ship it
# to the extension, the app, or the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Click hashing ────────────────────────────────────────────────────────────
# Random secret used to salt IP hashes so raw IPs are never stored.
# Generate one with:  openssl rand -hex 32
IP_HASH_SALT=replace-with-a-long-random-string

# ── Amazon Associates ────────────────────────────────────────────────────────
# Your Amazon Associates store tag. Appended to every Amazon product URL as
# `?tag=<value>` so purchases get attributed to your Associates account.
# Get this from Amazon Associates Central → Account Settings.
AMAZON_ASSOCIATE_TAG=

# ── Affiliate network (Sovrn) — not used yet ─────────────────────────────────
# Fill in once the Sovrn Commerce application is approved, then wire up
# src/lib/affiliate.js for non-Amazon retailers. Until then those run in
# passthrough mode.
SOVRN_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787

# Comma-separated list of origins allowed to call the API
# (the extension uses its own origin; the redirect page is same-origin in prod).
CORS_ORIGINS=https://sharewithripple.com,https://www.sharewithripple.com
